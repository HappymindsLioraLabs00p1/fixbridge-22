node_modules/
.next/
out/
dist/
build/
target/
*.class
.env
.env.*
!.env.example
.DS_Store
*.log
.idea/
.vscode/
*.iml
coverage/
.gradle/

# Terraform (keep .terraform.lock.hcl committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Local Netlify folder
.netlify

# Data exports contain real customer emails and property addresses. Keep them out of the
# repository — a backup belongs somewhere private, not in version control.
backups/
*fixbridge-backup-*.json

# Python AI service — virtualenv, caches and local secrets never belong in the repository
fixbridge-ai-service/.venv/
fixbridge-ai-service/.env
__pycache__/
*.py[cod]
.pytest_cache/

# Local-only copy of the AI service token for integration testing. Never committed.
.ai-service-token

# Local AI/provider configuration. Holds real keys — never tracked. See backend/Environment.example.
backend/Environment

# Android signing keys — losing these means never updating the Play listing; committing them means
# anyone can publish as you.
android/*.keystore
android/*.jks
android/app-release-*.aab
android/app-release-*.apk
