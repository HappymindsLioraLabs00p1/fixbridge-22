# FixBridge backend — environment template. Copy to .env (gitignored) and fill in.
# NOTHING here is committed with real values. Staging and production use separate values.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/fixbridge
DB_USER=fixbridge
DB_PASSWORD=fixbridge

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Server ---
PORT=8080

# --- Branding (single source of truth; frontend mirrors in src/config/brand.ts) ---
BRAND_NAME=FixBridge
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_DOMAIN=example.com
BRAND_PRIMARY_COLOR=#1f6feb

# --- Security / JWT ---
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=14
CORS_ORIGINS=http://localhost:3000

# --- AI (model names are configurable; never hard-coded) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Set to false to activate the LIVE OpenAI/Claude + Stripe clients (requires the keys below).
# Keep true for the deterministic stubs (no external keys needed).
INTEGRATIONS_STUB_MODE=true

# --- Stripe (used when INTEGRATIONS_STUB_MODE=false) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/customer?paid=1
STRIPE_CANCEL_URL=http://localhost:3000/customer?canceled=1
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/contractor?onboarded=1
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/contractor?refresh=1

# --- Storage (GCS) ---
GCS_BUCKET=fixbridge-dev
SIGNED_URL_TTL=15
