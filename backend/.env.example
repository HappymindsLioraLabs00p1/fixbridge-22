# Local backend configuration — copy to backend/.env and fill in the values.
#
# backend/.env is gitignored. This example is committed so the next person knows what is required
# without anyone having to guess, and without a real credential ever entering the repository.
#
# application.yml deliberately gives DB_PASSWORD no default: a password committed once stays in git
# history after it is deleted, and GitHub's secret scanning disables the database role within
# minutes of the push.
#
# Load it with either:
#   VS Code   — the "FixBridge backend" launch configuration reads this file
#   Terminal  — cd backend && set -a && source .env && set +a && java -jar target/fixbridge-backend-0.1.0.jar

# ---- Database (Neon staging) ----
DB_HOST=ep-holy-waterfall-ax7qkz0z-pooler.c-4.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PARAMS=?sslmode=require
DB_PASSWORD=

# ---- Integrations ----
# true keeps Stripe, notifications and storage stubbed: no network calls, no real money.
# Leave this true unless you are deliberately testing against live providers.
INTEGRATIONS_STUB_MODE=true

# ---- AI provider (optional) ----
# Without a key the stub assessor is used, which is enough for the whole job lifecycle.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
