# FixBridge backend — environment template. Copy to .env (gitignored) and fill in.
# NOTHING here is committed with real values. Staging and production use separate values.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/fixbridge
DB_USER=fixbridge
DB_PASSWORD=fixbridge

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Server ---
PORT=8080

# --- Branding (single source of truth; frontend mirrors in src/config/brand.ts) ---
BRAND_NAME=FixBridge
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_DOMAIN=example.com
BRAND_PRIMARY_COLOR=#1f6feb

# --- Security / JWT ---
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=14
CORS_ORIGINS=http://localhost:3000

# --- AI (provider and model names are configurable; never hard-coded) ---
# openai | claude | openrouter
AI_PROVIDER=openrouter

# OpenRouter: one key, many models. Model names are namespaced. Choose one that supports BOTH
# vision (we send job photos) and structured outputs (we require schema-valid JSON) — e.g.
# openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-2.0-flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Direct provider keys (only needed if AI_PROVIDER is openai or claude)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Sent to OpenRouter so requests are attributed to your app
AI_APP_URL=https://fixbridge.example.com
AI_APP_TITLE=FixBridge

# Ask the model to conform to our JSON schema. Set false only if a model rejects the parameter —
# replies are parsed defensively either way.
AI_STRUCTURED_OUTPUTS=true
# Set true for a reasoning model (e.g. an OpenRouter ":reasoning" variant)
AI_REASONING=false
# Set to false to activate the LIVE OpenAI/Claude + Stripe clients (requires the keys below).
# Keep true for the deterministic stubs (no external keys needed).
INTEGRATIONS_STUB_MODE=true

# --- Stripe (used when INTEGRATIONS_STUB_MODE=false) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/customer?paid=1
STRIPE_CANCEL_URL=http://localhost:3000/customer?canceled=1
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/contractor?onboarded=1
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/contractor?refresh=1

# --- Storage ---
# Live (stub-mode=false): private GCS bucket + V4 signed URLs (uses application default credentials).
GCS_BUCKET=fixbridge-dev
SIGNED_URL_TTL=15
# Stub mode: uploads/downloads route to this backend's own local object store.
STORAGE_PUBLIC_BASE_URL=http://localhost:8080

# --- Notifications (used when INTEGRATIONS_STUB_MODE=false) ---
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
