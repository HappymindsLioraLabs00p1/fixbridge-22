# FixBridge AI / Image Processing service
# Copy to .env for local development. Never commit real values.

ENVIRONMENT=development

# --- Service-to-service auth ----------------------------------------------------------------
# The Java backend sends this as a bearer token. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The SAME value goes into the Java service as AI_SERVICE_TOKEN.
SERVICE_AUTH_TOKEN=

# --- AI provider ----------------------------------------------------------------------------
# Leave STUB_MODE=true to run the full pipeline with no API key and no spend.
STUB_MODE=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Must support vision AND structured outputs.
VISION_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# --- Image limits (these are the cost controls) ----------------------------------------------
MAX_UPLOAD_BYTES=20971520
MAX_DIMENSION=1600
THUMBNAIL_DIMENSION=320
JPEG_QUALITY=82
MAX_IMAGES_PER_ASSESSMENT=4

# --- Rate limiting ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- Observability ---------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
